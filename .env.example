# ==============================================================================
# STUDYFLOW AI - ENVIRONMENT VARIABLES & CLOUD INTEGRATION TEMPLATE
# ==============================================================================
# Sao chép file này thành .env.local khi chạy dev trên máy,
# hoặc dán các biến này vào mục "Environment Variables" trên Vercel App.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database PostgreSQL & Storage miễn phí)
# Đăng ký tại: https://supabase.com (Miễn phí 500MB DB, 1GB Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 (Lưu trữ Video, Âm thanh bài giảng, Đề thi miễn phí)
# Đăng ký tại: https://dash.cloudflare.com (Miễn phí 10GB lưu trữ, 0đ phí băng thông)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=studyflow-media
NEXT_PUBLIC_MEDIA_CDN_URL=https://media.studyflow.ai

# ------------------------------------------------------------------------------
# 3. FIREBASE (Tùy chọn thay thế Supabase cho Auth/Firestore/Storage)
# Đăng ký tại: https://console.firebase.google.com (Gói Spark miễn phí)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studyflow-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studyflow-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=studyflow-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ------------------------------------------------------------------------------
# 4. SITE METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://studyflow-ai.vercel.app
